{
  "expo": {
    "name": "Fluxo",
    "slug": "fluxo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Permita que o Fluxo utilize Face ID para autenticar seu acesso de forma rápida e segura."
      }
    },
    "android": {
      "package": "com.devigmurilo.fluxo",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que o Fluxo utilize Face ID para autenticar seu acesso de forma rápida e segura."
        }
      ],
      "expo-font"
    ],
    "scheme": "fluxo",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "389508b6-b8c1-4ce3-8688-03404cf0aa5d"
      }
    },
    "owner": "devigmurilo"
  }
}
